<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Royal Grammar School & Academy, Khairpur</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
/* ============================
   DESIGN TOKENS
   ============================ */
:root {
  --navy: #00205b;
  --navy-deep: #001540;
  --gold: #c9a227;
  --gold-light: #e8c547;
  --gold-pale: #f9f2dc;
  --ivory: #fafaf7;
  --white: #ffffff;
  --slate: #4a5568;
  --slate-light: #718096;
  --border: #e8e8e8;
  --shadow-sm: 0 2px 8px rgba(0,32,91,0.08);
  --shadow-md: 0 8px 30px rgba(0,32,91,0.12);
  --shadow-lg: 0 20px 60px rgba(0,32,91,0.15);
  --radius: 12px;
  --radius-lg: 20px;
  --green: #25D366;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--ivory);
  color: var(--slate);
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: 'Playfair Display', serif;
  color: var(--navy);
}

/* ============================
   UTILITY
   ============================ */
.container { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
.section { padding: 80px 0; }
.section-alt { background: var(--white); }

.badge {
  display: inline-block;
  background: var(--gold-pale);
  color: var(--gold);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 50px;
  border: 1px solid var(--gold-light);
  margin-bottom: 12px;
}

.section-header { text-align: center; margin-bottom: 52px; }
.section-header h2 { font-size: 2.4rem; margin-bottom: 12px; }
.section-header p { color: var(--slate-light); max-width: 560px; margin: 0 auto; font-size: 1rem; }
.gold-rule {
  width: 48px; height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
  margin: 14px auto 16px;
  border-radius: 2px;
}

/* ============================
   HEADER & NAV
   ============================ */
header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 999;
  box-shadow: var(--shadow-sm);
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 24px;
  max-width: 1160px;
  margin: 0 auto;
  gap: 16px;
}

.logo-area {
  display: flex; align-items: center; gap: 14px;
  text-decoration: none;
}

.logo-crest {
  width: 52px; height: 52px;
  background: var(--navy);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--gold);
  flex-shrink: 0;
}
.logo-crest span {
  font-family: 'Playfair Display', serif;
  color: var(--gold);
  font-size: 1.1rem;
  font-weight: 900;
}

.logo-text-block h1 {
  font-size: 1.1rem;
  font-weight: 900;
  letter-spacing: 0.04em;
  line-height: 1.1;
}
.logo-text-block small {
  font-size: 0.68rem;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  display: block;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.nav-links a {
  text-decoration: none;
  color: var(--slate);
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 500;
  transition: all 0.2s;
}
.nav-links a:hover { background: var(--gold-pale); color: var(--navy); }

.nav-cta {
  background: var(--navy) !important;
  color: var(--white) !important;
  font-weight: 600 !important;
  padding: 9px 18px !important;
}
.nav-cta:hover { background: var(--gold) !important; color: var(--navy) !important; }

.nav-admin {
  background: var(--gold-pale) !important;
  color: var(--gold) !important;
  border: 1px solid var(--gold-light) !important;
  font-weight: 600 !important;
  cursor: pointer;
}
.nav-admin:hover { background: var(--gold) !important; color: var(--white) !important; }

/* ============================
   HERO
   ============================ */
.hero {
  position: relative;
  min-height: 88vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--navy-deep);
}

.hero-bg {
  position: absolute; inset: 0;
  background: url('https://images.unsplash.com/photo-1580582932707-520aed937b7b?q=80&w=1920') center/cover;
  opacity: 0.18;
}

/* Architectural diagonal stripe — the signature element */
.hero-stripe {
  position: absolute;
  top: 0; right: 0;
  width: 50%;
  height: 100%;
  background: linear-gradient(135deg, transparent 30%, rgba(201,162,39,0.07) 100%);
  border-left: 2px solid rgba(201,162,39,0.25);
  clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
}

.hero-content {
  position: relative; z-index: 2;
  max-width: 1160px;
  margin: 0 auto;
  padding: 80px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.hero-left {}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--gold);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 20px;
}
.hero-eyebrow::before {
  content: '';
  display: block;
  width: 28px; height: 2px;
  background: var(--gold);
}

.hero h2 {
  font-size: clamp(2.4rem, 4vw, 3.6rem);
  line-height: 1.12;
  color: var(--white);
  margin-bottom: 20px;
}
.hero h2 em {
  font-style: normal;
  color: var(--gold);
}

.hero-desc {
  color: rgba(255,255,255,0.72);
  font-size: 1.05rem;
  line-height: 1.7;
  margin-bottom: 36px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--gold);
  color: var(--navy);
  padding: 13px 30px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.25s;
}
.btn-primary:hover {
  background: var(--gold-light);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(201,162,39,0.35);
}

.btn-outline {
  background: transparent;
  color: var(--white);
  padding: 13px 30px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  border: 1.5px solid rgba(255,255,255,0.35);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.25s;
}
.btn-outline:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(255,255,255,0.1);
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
}
.stat-item {
  padding: 24px 16px;
  background: rgba(0,21,64,0.6);
  backdrop-filter: blur(10px);
  text-align: center;
}
.stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 900;
  color: var(--gold);
  line-height: 1;
}
.stat-label {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 4px;
}

/* ============================
   PROGRAMS
   ============================ */
.programs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}

.program-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
  transition: all 0.3s;
  box-shadow: var(--shadow-sm);
}
.program-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: var(--gold-light);
}

.program-top {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%);
  padding: 28px 24px 20px;
  position: relative;
  overflow: hidden;
}
.program-top::after {
  content: '';
  position: absolute;
  bottom: -20px; right: -20px;
  width: 80px; height: 80px;
  border-radius: 50%;
  background: rgba(201,162,39,0.12);
}

.program-icon {
  width: 52px; height: 52px;
  background: rgba(201,162,39,0.15);
  border: 1.5px solid rgba(201,162,39,0.4);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}
.program-icon i { color: var(--gold); font-size: 1.4rem; }

.program-top h3 { color: var(--white); font-size: 1.15rem; }

.program-body { padding: 20px 24px 24px; }
.program-body p { color: var(--slate-light); font-size: 0.9rem; line-height: 1.6; margin-bottom: 16px; }

.program-meta {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.meta-tag {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 3px 10px;
  background: var(--gold-pale);
  color: var(--gold);
  border-radius: 50px;
  border: 1px solid var(--gold-light);
}

/* ============================
   GALLERY
   ============================ */
.gallery-controls {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 32px;
}
.filter-btn {
  padding: 7px 18px;
  border-radius: 50px;
  border: 1.5px solid var(--border);
  background: var(--white);
  color: var(--slate);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}
.filter-btn.active, .filter-btn:hover {
  background: var(--navy);
  color: var(--white);
  border-color: var(--navy);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 18px;
}

.gallery-item {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--border);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
}
.gallery-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.gallery-item:hover img { transform: scale(1.08); }

.gallery-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,21,64,0.85), transparent);
  opacity: 0;
  transition: opacity 0.3s;
  display: flex; align-items: flex-end;
  padding: 16px;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-overlay span {
  color: var(--white);
  font-size: 0.82rem;
  font-weight: 600;
}

.gallery-placeholder {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: var(--slate-light);
  font-size: 0.95rem;
}
.gallery-placeholder i { font-size: 2.5rem; color: var(--border); display: block; margin-bottom: 12px; }

/* ============================
   NEWS / ANNOUNCEMENTS
   ============================ */
.news-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.news-card {
  background: var(--white);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  overflow: hidden;
  transition: box-shadow 0.25s;
  box-shadow: var(--shadow-sm);
}
.news-card:hover { box-shadow: var(--shadow-md); }

.news-card-top {
  background: linear-gradient(90deg, var(--navy), #0a3580);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.news-card-top .news-date {
  background: var(--gold);
  color: var(--navy);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 50px;
}
.news-card-top .news-cat {
  color: rgba(255,255,255,0.7);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.news-card-body { padding: 20px; }
.news-card-body h3 { font-size: 1rem; color: var(--navy); margin-bottom: 8px; }
.news-card-body p { color: var(--slate-light); font-size: 0.88rem; line-height: 1.6; }

/* ============================
   CAREERS
   ============================ */
.careers-intro {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 60px;
}
.careers-intro-text h3 { font-size: 1.7rem; margin-bottom: 14px; }
.careers-intro-text p { color: var(--slate-light); line-height: 1.7; margin-bottom: 20px; }

.careers-perks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.perk-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.88rem;
  color: var(--slate);
  font-weight: 500;
}
.perk-item i { color: var(--gold); width: 18px; }

.job-listings { display: flex; flex-direction: column; gap: 18px; }

.job-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16px;
  align-items: center;
  transition: all 0.25s;
  box-shadow: var(--shadow-sm);
}
.job-card:hover {
  border-color: var(--gold-light);
  box-shadow: var(--shadow-md);
  transform: translateX(4px);
}

.job-card-left h3 { font-size: 1.05rem; margin-bottom: 6px; }
.job-meta {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 10px;
}
.job-tag {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.78rem;
  color: var(--slate-light);
}
.job-tag i { color: var(--gold); font-size: 0.72rem; }

.job-deadline {
  font-size: 0.75rem;
  color: #e53e3e;
  font-weight: 600;
  margin-top: 6px;
}

.apply-btn {
  background: var(--navy);
  color: var(--white);
  padding: 10px 22px;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
  text-decoration: none;
  display: inline-block;
  text-align: center;
}
.apply-btn:hover { background: var(--gold); color: var(--navy); }

/* ============================
   APPLICATION FORM MODAL
   ============================ */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,21,64,0.75);
  backdrop-filter: blur(6px);
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.modal {
  background: var(--white);
  border-radius: var(--radius-lg);
  max-width: 640px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  transform: translateY(20px);
  transition: transform 0.3s;
}
.modal-overlay.open .modal { transform: translateY(0); }

.modal-head {
  background: linear-gradient(135deg, var(--navy), var(--navy-deep));
  padding: 28px 28px 24px;
  position: relative;
}
.modal-head h3 {
  color: var(--white);
  font-size: 1.3rem;
  margin-bottom: 4px;
}
.modal-head p { color: rgba(255,255,255,0.65); font-size: 0.88rem; }
.modal-head .job-applied {
  background: var(--gold-pale);
  color: var(--gold);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 50px;
  border: 1px solid var(--gold-light);
  margin-top: 10px;
  display: inline-block;
}

.modal-close {
  position: absolute;
  top: 16px; right: 16px;
  background: rgba(255,255,255,0.12);
  border: none;
  color: var(--white);
  width: 34px; height: 34px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1rem;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s;
}
.modal-close:hover { background: rgba(255,255,255,0.25); }

.modal-body { padding: 28px; }

/* ============================
   FORM ELEMENTS (shared)
   ============================ */
.form-group { margin-bottom: 18px; }
.form-group label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--navy);
  margin-bottom: 6px;
}
.form-group label span { color: #e53e3e; }

.form-control {
  width: 100%;
  padding: 11px 14px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-family: 'Inter', sans-serif;
  font-size: 0.92rem;
  color: var(--slate);
  background: var(--ivory);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.form-control:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(201,162,39,0.15);
  background: var(--white);
}

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

textarea.form-control { resize: vertical; min-height: 90px; }

select.form-control { appearance: none; cursor: pointer; }

.file-input-wrap {
  border: 2px dashed var(--border);
  border-radius: 10px;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  background: var(--ivory);
}
.file-input-wrap:hover { border-color: var(--gold); background: var(--gold-pale); }
.file-input-wrap input { display: none; }
.file-input-wrap i { font-size: 1.8rem; color: var(--gold); display: block; margin-bottom: 8px; }
.file-input-wrap p { font-size: 0.85rem; color: var(--slate-light); }
.file-input-wrap strong { color: var(--navy); }
.file-name { font-size: 0.8rem; color: var(--gold); font-weight: 600; margin-top: 6px; }

.form-footer { margin-top: 24px; }
.form-footer .note {
  font-size: 0.78rem;
  color: var(--slate-light);
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin-bottom: 16px;
}
.form-footer .note i { color: var(--green); margin-top: 2px; }

/* ============================
   CONTACT
   ============================ */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 40px;
}

.contact-card {
  background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
  border-radius: var(--radius-lg);
  padding: 36px;
  color: var(--white);
  position: relative;
  overflow: hidden;
}
.contact-card::before {
  content: '';
  position: absolute;
  bottom: -40px; right: -40px;
  width: 160px; height: 160px;
  border-radius: 50%;
  background: rgba(201,162,39,0.08);
  border: 40px solid rgba(201,162,39,0.05);
}

.contact-card h3 { color: var(--white); margin-bottom: 6px; }
.contact-card > p { color: rgba(255,255,255,0.65); font-size: 0.9rem; margin-bottom: 28px; }

.contact-detail {
  display: flex;
  gap: 12px;
  margin-bottom: 18px;
  align-items: flex-start;
}
.contact-detail-icon {
  width: 38px; height: 38px;
  background: rgba(201,162,39,0.15);
  border: 1px solid rgba(201,162,39,0.3);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.contact-detail-icon i { color: var(--gold); font-size: 0.9rem; }
.contact-detail-text p { font-size: 0.78rem; color: rgba(255,255,255,0.5); }
.contact-detail-text strong { color: var(--white); font-size: 0.92rem; }

.quick-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

.qa-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 18px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}
.qa-wa { background: var(--green); color: var(--white); }
.qa-call { background: rgba(255,255,255,0.12); color: var(--white); border: 1px solid rgba(255,255,255,0.2); }
.qa-sms { background: var(--gold); color: var(--navy); }
.qa-btn:hover { transform: scale(1.04); opacity: 0.9; }

.inquiry-form {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 36px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}
.inquiry-form h3 { margin-bottom: 4px; }
.inquiry-form > p { color: var(--slate-light); font-size: 0.88rem; margin-bottom: 24px; }

/* ============================
   ADMIN PANEL
   ============================ */
.admin-panel {
  display: none;
  background: var(--white);
  border: 2px solid var(--gold-light);
